# Spring does not read .env automatically. Export these variables before running Java.
AGENTS_DATABASE_URL=jdbc:postgresql://localhost:5433/instantly_agents
AGENTS_DATABASE_USERNAME=agents
AGENTS_DATABASE_PASSWORD=agents-local
AGENTS_ENABLED=false
INSTANTLY_API_URL=http://localhost:8080
AGENT_ACCOUNTS_FILE=./secrets/accounts.json
AGENT_KEY_DIRECTORY=./keys
# Protects private identity files only, never conversation data in PostgreSQL.
# Generate once: openssl rand -base64 32. Keep the existing value when upgrading.
AGENT_IDENTITY_KEY=
# Upgrading a database from the encrypted prototype: also export its original
# AGENT_STORAGE_KEY for the one-time Liquibase data conversion.
OPENAI_API_KEY=
# An OpenAI Responses API model available to your project; required when enabled.
OPENAI_MODEL=
AGENT_REPLY_CONCURRENCY=4
AGENT_MAX_ATTEMPTS=8
AGENT_REPLY_DELAY_SECONDS=3
